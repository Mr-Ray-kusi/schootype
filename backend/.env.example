# Backend environment (copy to backend/.env and fill in values)

# Public URLs (magic-link emails use FRONTEND_URL)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Email (required for signup verification + broadcasts)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=gmail
BROADCAST_EMAIL=

# Twilio SMS (platform account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=233
SMS_DRY_RUN=false
SMS_SEND_CONCURRENCY=5
