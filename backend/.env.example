# Backend environment (copy to backend/.env and fill in values)

# Public URLs (magic-link emails use FRONTEND_URL)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# JWT signing secret (32+ characters). Required in production.
JWT_SECRET=

# Google sign-in / sign-up (Web client ID from Google Cloud Console)
# Also add authorized JS origins: http://localhost:3000 and your production site
GOOGLE_CLIENT_ID=

# Email (required for signup verification + broadcasts)
# EMAIL_USER = the Gmail/SMTP account that SENDS mail (not the signup recipient)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=gmail
# Optional alias; never used as verification recipient
BROADCAST_EMAIL=

# Twilio SMS (platform account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=233
SMS_DRY_RUN=false
SMS_SEND_CONCURRENCY=5

# Daily Vercel cron for subscription due reminders (Authorization: Bearer <secret>)
CRON_SECRET=

# Paystack (live keys from your approved Ghana business account)
# Secret key stays on the server only. Public key is returned to checkout.
# Use sk_live_ / pk_live_ in production. Test keys (sk_test_) will not collect real fees.
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_CURRENCY=GHS
# Optional: percent of each parent fee payment kept by Schooltype. 0 = the school receives the settlement.
PAYSTACK_PLATFORM_PERCENT=0
# In Paystack Dashboard → Settings → API Keys & Webhooks:
#   Webhook URL: https://YOUR-DOMAIN/api/webhooks/paystack
# Enable Ghana channels: Mobile Money, Bank, Bank Transfer (parents can pay Bank Transfer via USSD).
# School fees checkout uses: card, bank, bank_transfer, mobile_money.
# On Vercel, wallets use Supabase automatically. Locally you can force that with:
# WALLET_STORE=supabase
# Production also needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, and the wallet
# tables from database/supabase_core_billing.sql + supabase_backend_access.sql.
# In Paystack Dashboard → Settings → API Keys & Webhooks, set webhook URL to:
#   https://YOUR-DOMAIN/api/webhooks/paystack
# For local testing use the ngrok/https URL of backend, same path.
