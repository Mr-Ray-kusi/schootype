# Backend environment (copy to backend/.env and fill in values)

# Supabase
SUPABASE_URL=
# Prefer the service role key for the backend (bypasses RLS). Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback only — anon key is blocked by RLS for school writes
SUPABASE_ANON_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Server
PORT=5000
# Public URLs used for Paystack callback redirects
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers)
# Currency must match your Paystack business (Ghana = GHS). Options: GHS | USD | NGN
PAYSTACK_CURRENCY=GHS
# Plan prices auto-select for currency: GHS ₵200/500/750 · USD $20/50/75 · NGN ₦20k/50k/75k
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Webhook signature uses PAYSTACK_SECRET_KEY (HMAC SHA512).
# Point Paystack webhook URL to: {BACKEND_URL}/api/payments/webhook

# Super admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_EMAILS=
DEV_SUPER_ADMIN_EMAIL=
DEV_SUPER_ADMIN_PASSWORD=
DEV_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN=false

# Email (optional)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=gmail
BROADCAST_EMAIL=
PARENTS_EMAIL=
TEACHERS_EMAIL=
STAFF_EMAIL=
